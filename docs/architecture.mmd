flowchart TD
    subgraph Inputs["Synthetic data (no PHI)"]
        PK["data/packets/*.json<br/>26 intake packets"]
        POL["data/policies.json<br/>per-CPT clinical requirements"]
        MEM["data/members.json<br/>eligibility snapshot"]
    end

    subgraph Pipeline["src/pipeline.py — proposes, never finalizes"]
        C["1 · completeness.check()<br/>deterministic: fields, NPI Luhn,<br/>ICD-10/CPT format, eligibility<br/>LLM: clinical-notes vs policy"]
        F["2 · followups.draft()<br/>LLM letter → rubric check in code<br/>→ 1 retry → template fallback<br/>(loop-engineering Loop 2)"]
        R["3 · router.route()<br/>deterministic decision table<br/>(auditable, no LLM)"]
    end

    subgraph LLMLayer["src/llm.py — provider ladder"]
        L["ANTHROPIC_API_KEY → Claude<br/>GEMINI_API_KEY → Gemini (free)<br/>neither/failure/refusal → offline<br/>structured outputs · 429 retry ·<br/>call-integrity counters"]
    end

    subgraph Gate["4 · HUMAN APPROVAL GATE"]
        UI["app/review_app.py (Streamlit)<br/>or CLI --approve<br/>approve / edit letter / reject"]
    end

    AUD[("audit_log.jsonl<br/>append-only: every proposal<br/>+ every human decision")]

    subgraph Quality["Quality harness"]
        GL["data/golden_labels.json<br/>(read ONLY by evals)"]
        EV["evals/run_evals.py<br/>P/R/F1 · routing · rubric ·<br/>LLM call integrity"]
        T["tests/ (pytest ×17)"]
    end

    PK --> C
    POL --> C
    MEM --> C
    C --> F
    C --> R
    F --> R
    C -.LLM calls.-> L
    F -.LLM calls.-> L
    R -->|"proposal (pending)"| UI
    UI --> AUD
    Pipeline -.logs proposals.-> AUD
    GL --> EV
    EV -.scores.-> Pipeline
    T -.verifies.-> Pipeline

    style Gate fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style LLMLayer fill:#fff3e0,stroke:#ef6c00
    style Quality fill:#e3f2fd,stroke:#1565c0
